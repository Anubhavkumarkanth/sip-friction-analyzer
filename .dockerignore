# Keep secrets, local state and bulky folders out of the build context.
# Without this, `COPY . .` copies a local .env (with SECRET_KEY and database
# credentials) into an image layer.
.env
.env.*
!.env.example
.git
.github
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.coverage
htmlcov
*.db
*.sqlite3
docs
node_modules
frontend/node_modules
frontend/dist
frontend/coverage
