# Copy to .env and fill in. .env is gitignored and must never be committed.

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://sip_app:<your-local-password>@localhost:5432/sip

# JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If left unset the server generates a random key per process, so tokens stop
# working on restart.
SECRET_KEY=<generate-your-own>

# Optional seed account. If DEFAULT_ADMIN_PASSWORD is unset, no account is created.
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=<choose-a-local-password>
