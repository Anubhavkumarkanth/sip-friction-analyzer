# Environment Configuration for SIP Friction Analyzer Backend
# Copy to .env for local overrides

# Database Connection (Defaults to local SQLite)
DATABASE_URL=sqlite:///./sip.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/sip_db

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-in-production-min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Default Seed Credentials
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123
